{
  "name": "@cesarus777/opencode-censor",
  "version": "0.3.1",
  "description": "Fail-safe native OpenCode V2 shell permission reviews using an independent model",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "examples",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.11"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "permissions",
    "security",
    "llm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check src tests scripts *.json *.md docs examples .github",
    "format": "prettier --write src tests scripts *.json *.md docs examples .github",
    "test": "bun test tests",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:live": "bun scripts/live-smoke.ts",
    "test:package": "bun scripts/package-check.ts",
    "check": "bun run typecheck && bun run lint && bun test tests && bun run build && bun run test:package",
    "prepack": "bun run build",
    "stats": "node dist/stats.js",
    "test:live:free": "bun scripts/free-provider-smoke.ts"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "devDependencies": {
    "@opencode/client": "2.2.5",
    "@types/bun": "1.3.11",
    "typescript": "5.9.3",
    "prettier": "3.6.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cesarus777/opencode-censor.git"
  },
  "homepage": "https://github.com/cesarus777/opencode-censor#readme",
  "bugs": {
    "url": "https://github.com/cesarus777/opencode-censor/issues"
  },
  "bin": {
    "censor-stats": "./dist/stats.js"
  }
}
